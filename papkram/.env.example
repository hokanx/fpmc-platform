# Papkram — environment template. Copy to .env (git-ignored). Never commit real keys.
#
# Only ANTHROPIC_API_KEY is required to run. Everything else has a working
# default, except the IMPRESSUM_* block, which is required before going public.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# Which AI provider processes the letter.
#   anthropic  Claude, US processing under a DPA. Best German Leichte-Sprache quality. (default)
#   mistral    Mistral, EU data residency end-to-end. Cleanest GDPR story.
# This value also decides which provider /datenschutz names — the page follows the code.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Model override. Default claude-sonnet-5 (~$0.01 per single-page letter).
# claude-opus-5 is roughly 3x the cost and handles gnarly Behördendeutsch better —
# worth switching to if summaries turn out to miss things on real letters.
# ANTHROPIC_MODEL=claude-sonnet-5
# Thinking depth: low | medium | high | xhigh | max. Default high, because a
# misread deadline or amount costs the reader money. Lower it if latency matters more.
# ANTHROPIC_EFFORT=high

# Only needed when AI_PROVIDER=mistral.
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest

# ---------------------------------------------------------------------------
# Impressum — required by § 5 DDG before the site is public
# ---------------------------------------------------------------------------
# Served to /impressum via /api/info, so filling these in is a settings change
# rather than a code change. The page shows a visible warning until the four
# required fields are set. None of this is secret — it is legally public info.

IMPRESSUM_NAME=
IMPRESSUM_STRASSE=
IMPRESSUM_ORT=
IMPRESSUM_EMAIL=
# Optional.
# IMPRESSUM_LAND=Deutschland
# IMPRESSUM_VERTRETEN=
# IMPRESSUM_USTID=

# ---------------------------------------------------------------------------
# Abuse protection and spend control
# ---------------------------------------------------------------------------

# Requests per IP per hour; a multi-page letter costs one per page. Default 20.
# RATE_LIMIT_PER_HOUR=20

# Global daily request cap — the spend guard. 0 disables it. Default 2000.
# At the Sonnet 5 default that bounds a runaway day at roughly $20.
# DAILY_REQUEST_CAP=2000

# Without these, rate limiting is per serverless instance and resets on cold
# starts — a speed bump, not a control. Set them before taking real traffic.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: POST target for error reports (Slack webhook, Sentry, anything that
# takes JSON). Reports carry a route name, an error code and counts — never
# letter content. Unset, errors go to stderr, which Vercel already collects.
# ERROR_WEBHOOK_URL=
