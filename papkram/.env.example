# Papkram — environment template. Copy to .env (git-ignored). Never commit real keys.

# Which AI provider processes the letter.
#   anthropic  Claude, US processing under a DPA. Best German Leichte-Sprache quality. (default)
#   mistral    Mistral, EU data residency end-to-end. Cleanest GDPR story.
# This value also decides which provider /datenschutz names — the page follows the code.
AI_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model override. Default claude-opus-5 (~$0.03 per letter).
# claude-sonnet-5 is roughly a third of that with somewhat weaker Behördendeutsch handling.
# ANTHROPIC_MODEL=claude-opus-5
# Thinking depth: low | medium | high | xhigh | max. Default medium.
# ANTHROPIC_EFFORT=medium

# --- Mistral (only needed when AI_PROVIDER=mistral) ---
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest

# --- Abuse protection ---
# Requests per IP per hour. Best-effort only (per serverless instance). Default 20.
# RATE_LIMIT_PER_HOUR=20
